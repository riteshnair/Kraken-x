# Whitelist-based ignore: experiment scratch, build outputs, logs, and model
# artifacts stay outside Git. Only the Kraken project sources and current docs
# are tracked.
/*
!/.gitignore
!/CMakeLists.txt
!/README.md
!/AGENTS.md
!/TO-DO.md
!/include/
!/src/
!/tests/
!/scripts/
!/tools/
!/docs/
!/palcfg/
# Source patches carried against sibling projects, applied by hand.
!/patches/

# Python bytecode and editor/tool caches.
__pycache__/
*.pyc
.pytest_cache/

# Build, sanitizer, test, and profiling outputs.
build*/
cmake-build-*/
krk-tests-*/
*.log
*.err
*.out
*.prof
*.profraw
*.gcda
*.gcno
*.core
core
reports/

# Keep current written documentation, not generated transcripts or traces.
/docs/*
!/docs/*.md
/docs/traces/

# Model weights and downloaded data never belong in this repository.
*.gguf
*.ggml
*.safetensors
*.pt
*.pth
*.npz
google_drive/
models/

# Binary patch archives and experiment bundles. Source patches remain tracked.
*.zip
*.tar
*.tar.gz
